{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd server && chmod +x gradlew && ./gradlew build jar -x test"
  },
  "deploy": {
    "startCommand": "cd server && java -jar build/libs/server-1.0-SNAPSHOT.jar",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

